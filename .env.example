# =============================================================================
# RiotQueens.ai — contrato de entorno
# Autoridad: AGENTS.md (operacional) · DOSSIER_MAESTRO.md (persona) · ADR 0005 prefijo RIOTQUEENS_
# Regla única: secretos viven SOLO en el .env real (gitignored).
# Nunca en Git, logs, handoffs ni chat. Este archivo es plantilla sin secretos.
# =============================================================================

# --- 1. Entorno y puertos -----------------------------------------------------
APP_ENV=development
API_PORT=8000
WEB_PORT=3000

# --- 2. Origen único (Caddy enruta /api/* hacia FastAPI) ----------------------
SITE_ADDRESS=:80
NEXT_PUBLIC_API_URL=/api
RIOTQUEENS_CORS_ORIGINS=http://localhost,http://localhost:3000

# --- 3. Persistencia durable (PostgreSQL) --------------------------------------
POSTGRES_DB=riotqueens
POSTGRES_USER=riotqueens
POSTGRES_PASSWORD=riotqueens_dev
DATABASE_URL=postgresql://riotqueens:riotqueens_dev@localhost:5432/riotqueens

# --- 4. Identidad (Auth0 CA como IAM externo — C3 / ADR 0008) ------------------
# La identidad durable es el UUID RiotQueens propio; Auth0 nunca es PK de dominio.
RIOTQUEENS_AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_ENABLED=false
APP_BASE_URL=http://localhost:3000
RIOTQUEENS_AUTH0_ISSUER=https://riotqueens-ai-ca.ca.auth0.com/
RIOTQUEENS_AUTH0_AUDIENCE=https://api.riotqueens.ai
RIOTQUEENS_AUTH0_JWKS_URL=https://riotqueens-ai-ca.ca.auth0.com/.well-known/jwks.json
AUTH0_SECRET=
AUTH0_DOMAIN=riotqueens-ai-ca.ca.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.riotqueens.ai
AUTH0_SCOPE=openid profile email
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=https://api.riotqueens.ai

# --- 5. Voz de las Queens (modelo activo) --------------------------------------
# Decisión vigente: AGENTS.md §3 (modelos/tiers).
# Objetivo: self-host vLLM, open source + unrestricted. Gemini DESCARTADO.
# provider=mock mantiene dev/tests sin claves y sin red.
RIOTQUEENS_MODEL_PROVIDER=mock
RIOTQUEENS_MODEL_BASE_URL=
RIOTQUEENS_MODEL_API_KEY=
RIOTQUEENS_MODEL_NAME=
# OpenRouter 70B needs headroom; 5s timeout fails smoke turns.
RIOTQUEENS_MODEL_TIMEOUT_SECONDS=60.0
RIOTQUEENS_MODEL_MAX_RETRIES=1
RIOTQUEENS_MODEL_TEMPERATURE=0.9
# T1 clamp 180–220 (default 200). Owner 2026-08-28: mantener valor actual.
RIOTQUEENS_MODEL_MAX_TOKENS=200
# Persona: full dossier (compose override). Legacy env name kept.
RIOTQUEENS_BARDERA_PRESET=/app/DOSSIER_MAESTRO.md
RIOTQUEENS_DOSSIER_MAESTRO=/app/DOSSIER_MAESTRO.md
RIOTQUEENS_MODEL_FREQUENCY_PENALTY=0.4
RIOTQUEENS_MODEL_OMIT_FREQUENCY_PENALTY=false

# --- 6. Puente transitorio cloud (sólo hasta tener GPU propia) ------------------
# Ruta provisional mientras el stack vLLM no esté desplegado. Sin Gemini.
RIOTQUEENS_FALLBACK_MODEL_PROVIDER=openai
RIOTQUEENS_FALLBACK_MODEL_BASE_URL=https://openrouter.ai/api/v1
RIOTQUEENS_FALLBACK_MODEL_API_KEY=
RIOTQUEENS_FALLBACK_MODEL_NAME=sao10k/l3.3-euryale-70b
RIOTQUEENS_FALLBACK_MODEL_TEMPERATURE=0.9
RIOTQUEENS_FALLBACK_MODEL_FREQUENCY_PENALTY=0.5
RIOTQUEENS_FALLBACK_MODEL_OMIT_FREQUENCY_PENALTY=false

# --- 7. Límites de conversación, memoria y clickwrap ----------------------------
RIOTQUEENS_CONVERSATION_MAX_TURNS=8
RIOTQUEENS_MEMORY_MAX_PER_SCOPE=32
# Overrides opcionales del paquete clickwrap (defaults 2026-08-09):
# RIOTQUEENS_AGE_GATE_VERSION=2026-08-09
# RIOTQUEENS_TERMS_VERSION=2026-08-09
# RIOTQUEENS_PRIVACY_VERSION=2026-08-09

# --- 8. Owner Console (/v1/usuario /v1/root /v1/compare) — fail-closed ----------
# Prod (Auth0 on): CSV de Auth0 `sub`. Vacío = 403.
RIOTQUEENS_OWNER_AUTH0_SUBJECTS=
# Local (RIOTQUEENS_AUTH_ENABLED=false): CSV de user_id del body. Vacío = 403.
RIOTQUEENS_OWNER_USER_IDS=
